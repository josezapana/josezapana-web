---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro'; // Verifica que la ruta hacia tu Layout principal sea correcta

export async function getStaticPaths() {
  const projects = await getCollection('student-projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
---

<Layout title={`${project.data.title} | Ing. José Zapana`}>
  <main class="pt-24 pb-16 min-h-screen relative">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Botón de retorno -->
      <a 
        href="/#alumnos" 
        class="inline-flex items-center text-xs font-semibold text-primary hover:underline mb-8 transition-colors"
      >
        ← Volver a Proyectos
      </a>

      <!-- Header de la publicación -->
      <header class="border-b border-border/60 pb-8 mb-8">
        <div class="flex items-center gap-3 text-xs text-cyan-400 font-mono tracking-wider mb-3">
          {project.data.category && <span class="uppercase">{project.data.category}</span>}
          {project.data.academicYear && (
            <>
              <span>•</span>
              <span>{project.data.academicYear}</span>
            </>
          )}
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold text-neutral-100 tracking-tight mb-4">
          {project.data.title}
        </h1>

        <div class="flex flex-wrap items-center justify-between gap-4 text-xs text-neutral-400 pt-2">
          <p>
            Autor: <strong class="text-neutral-200 font-semibold">{project.data.student}</strong>
          </p>
          {project.data.role && (
            <span class="px-2.5 py-1 bg-primary/10 text-primary border border-primary/20 rounded-md font-mono text-[11px]">
              {project.data.role}
            </span>
          )}
        </div>

        <!-- Tags -->
        {project.data.tags && project.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-6">
            {project.data.tags.map((tag) => (
              <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-neutral-800/80 text-neutral-300 border border-neutral-700/50">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <!-- Cuerpo del artículo en Markdown -->
      <div class="prose prose-invert max-w-none prose-headings:text-neutral-100 prose-p:text-neutral-300 prose-p:leading-relaxed prose-a:text-primary hover:prose-a:underline prose-strong:text-neutral-100 prose-code:text-cyan-300 prose-pre:border prose-pre:border-border/50">
        <Content />
      </div>

    </div>
  </main>
</Layout>