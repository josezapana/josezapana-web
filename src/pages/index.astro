---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import StudentCard from '../components/StudentCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { getCollection } from 'astro:content';

const studentProjects = await getCollection('student-projects');
---

<Layout title="Ing. José Zapana | Cátedra e Investigación UNJu">
  <!-- Navbar Fijo Superior -->
  <Navbar />

  <main class="bg-background min-h-screen text-foreground antialiased selection:bg-primary selection:text-white">
    <!-- Hero / Sobre Mí con Glass Card y Foto -->
    <Hero />

    <!-- Sección de Proyectos de Alumnos -->
    <section id="alumnos" class="py-16 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10 text-center">
        <h2 class="text-3xl font-bold tracking-tight text-foreground">Proyectos Destacados de Alumnos</h2>
        <p class="text-muted-foreground mt-2">Trabajos de cátedra y proyectos de grado con impacto real.</p>
        <div class="w-12 h-1 bg-gradient-primary mx-auto mt-3 rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {studentProjects.map((project) => (
          <StudentCard project={project} />
        ))}
      </div>
    </section>

    <!-- Sección de Contacto -->
    <section id="contacto" class="py-16 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-card p-8 rounded-2xl border border-border/60">
        <ContactForm />
      </div>
    </section>
  </main>
</Layout>