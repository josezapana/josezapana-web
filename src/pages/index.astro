---
import Layout from '../layouts/Layout.astro';
import StudentCard from '../components/StudentCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { getCollection } from 'astro:content';

const studentProjects = await getCollection('student-projects');
---

<Layout title="Ing. José Zapana | Cátedra e Investigación UNJu">
  <!-- Hero Section -->
  <section class="mb-16 mt-8">
    <div class="inline-block px-3 py-1 mb-4 text-xs font-mono text-emerald-400 bg-emerald-950/30 border border-emerald-800/40 rounded">
      Facultad de Ingeniería — UNJu
    </div>
    <h1 class="text-4xl font-extrabold text-zinc-100 tracking-tight sm:text-5xl mb-4">
      Ing. José Vidal Zapana
    </h1>
    <p class="text-lg text-zinc-400 leading-relaxed max-w-3xl mb-6">
      Docente e Investigador en Ingeniería de Software y Sistemas Distribuidos. Especializado en arquitectura de software de alta concurrencia, integración de modelos de Inteligencia Artificial al ciclo de vida del software y formación de talento informático de alto rendimiento.
    </p>
  </section>

  <hr class="border-zinc-800 my-12" />

  <!-- Showcase de Alumnos -->
  <section class="mb-16">
    <div class="flex justify-between items-end mb-8">
      <div>
        <h2 class="text-2xl font-bold text-zinc-100">Vitrina de Proyectos de Alumnos</h2>
        <p class="text-sm text-zinc-400 mt-1">Desarrollos destacados de cátedra listos para vinculación tecnológica y pasantías.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {studentProjects.map((project) => (
        <StudentCard
          title={project.data.title}
          description={project.data.description}
          students={project.data.students}
          course={project.data.course}
          tags={project.data.tags}
          demoUrl={project.data.demoUrl}
          repoUrl={project.data.repoUrl}
          isHiringReady={project.data.isHiringReady}
        />
      ))}
    </div>
  </section>

  <!-- Formulario Serverless -->
  <ContactForm />
</Layout>