---
const { project } = Astro.props;
const { data } = project;

// Destructuring con valores por defecto seguros (evita crashes por campos undefined)
const {
  title = "Proyecto sin título",
  description = "",
  students = [],
  tags = [],
  demoUrl,
  githubUrl
} = data;

// Formateo seguro de alumnos
const studentsList = Array.isArray(students) ? students.join(", ") : (students || "Alumno / Equipo");
---

<article class="glass-card rounded-2xl p-6 flex flex-col justify-between hover:border-primary/50 transition-all duration-300 group">
  <div>
    <!-- Encabezado de la Card -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <h3 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors">
        {title}
      </h3>
    </div>

    <!-- Descripción Corta -->
    <p class="text-muted-foreground text-sm line-clamp-3 mb-4 leading-relaxed">
      {description}
    </p>

    <!-- Integrantes / Alumnos -->
    <div class="mb-4 pt-3 border-t border-border/40">
      <span class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1">
        Desarrollado por:
      </span>
      <p class="text-sm font-medium text-foreground/90">
        {studentsList}
      </p>
    </div>

    <!-- Tags / Tecnologías -->
    {Array.isArray(tags) && tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-6">
        {tags.map((tag) => (
          <span class="text-xs font-mono bg-secondary text-secondary-foreground px-2.5 py-1 rounded-lg border border-border/40">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </div>

  <!-- Botones de Acción / Links -->
  <div class="flex items-center gap-3 pt-4 border-t border-border/40 text-xs font-semibold">
    {githubUrl && (
      <a 
        href={githubUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-secondary text-secondary-foreground hover:bg-secondary/80 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        Código
      </a>
    )}

    {demoUrl && (
      <a 
        href={demoUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-primary text-primary-foreground hover:opacity-90 transition-opacity ml-auto"
      >
        Ver Demo
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </a>
    )}
  </div>
</article>