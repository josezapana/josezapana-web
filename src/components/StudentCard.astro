---
interface Props {
  title: string;
  description: string;
  students: string[];
  course: string;
  tags: string[];
  demoUrl?: string;
  repoUrl?: string;
  isHiringReady: boolean;
}

const { title, description, students, course, tags, demoUrl, repoUrl, isHiringReady } = Astro.props;
---

<div class="border border-zinc-800 bg-zinc-900/50 p-6 rounded-lg transition-all hover:border-zinc-700">
  <div class="flex justify-between items-start mb-3">
    <span class="text-xs font-mono text-emerald-400 bg-emerald-950/40 border border-emerald-800/50 px-2.5 py-1 rounded">
      {course}
    </span>
    {isHiringReady && (
      <span class="text-xs font-mono bg-blue-950/40 text-blue-400 border border-blue-800/50 px-2 py-0.5 rounded flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
        Disponible para Pasantías
      </span>
    )}
  </div>

  <h3 class="text-xl font-bold text-zinc-100 mb-2">{title}</h3>
  <p class="text-zinc-400 text-sm mb-4 leading-relaxed">{description}</p>

  <div class="mb-4">
    <p class="text-xs text-zinc-500 uppercase tracking-wider mb-1 font-mono">Desarrolladores</p>
    <p class="text-sm font-medium text-zinc-300">{students.join(", ")}</p>
  </div>

  <div class="flex flex-wrap gap-1.5 mb-6">
    {tags.map((tag) => (
      <span class="text-xs font-mono bg-zinc-800 text-zinc-300 px-2 py-0.5 rounded">
        #{tag}
      </span>
    ))}
  </div>

  <div class="flex items-center gap-4 pt-4 border-t border-zinc-800/60 text-sm font-mono">
    {demoUrl && (
      <a href={demoUrl} target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:underline flex items-center gap-1">
        Demo Live &rarr;
      </a>
    )}
    {repoUrl && (
      <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-zinc-200 underline">
        Código Fuente
      </a>
    )}
  </div>
</div>