---
interface Props {
  title: string;
  student: string;
  summary: string;
  tags: string[];
  slug: string;
}

const { title, student, summary, tags, slug } = Astro.props;
---

<a 
  href={`/proyectos/${slug}`} 
  class="group block p-6 bg-neutral-900/60 border border-neutral-800 rounded-xl hover:border-neutral-700 transition-all duration-200"
>
  <h3 class="text-lg font-bold text-white group-hover:text-primary transition-colors mb-2">
    {title}
  </h3>
  <p class="text-xs font-medium text-neutral-400 mb-3">
    Autor: <span class="text-neutral-200">{student}</span>
  </p>
  <p class="text-sm text-neutral-400 line-clamp-3 mb-4 leading-relaxed">
    {summary}
  </p>
  
  <div class="flex flex-wrap gap-1.5">
    {tags.map((tag) => (
      <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-neutral-800 text-neutral-300 border border-neutral-700/50">
        {tag}
      </span>
    ))}
  </div>
</a>