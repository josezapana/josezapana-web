---
import { translations } from '../data/i18n';
const t = translations.es;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-background/80 backdrop-blur-md border-b border-border/40">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    
    <!-- Branding / Logo -->
    <a href="#inicio" class="font-bold text-base tracking-tight flex items-center space-x-1.5 transition-opacity hover:opacity-90">
      <span class="text-neutral-100">Ing. José</span>
      <span class="bg-gradient-to-r from-blue-400 via-cyan-400 to-primary bg-clip-text text-transparent font-extrabold">
        Zapana
      </span>
      <span class="text-primary font-black">.</span>
    </a>

    <!-- Menú de Navegación -->
    <div class="flex items-center space-x-6">
      <nav class="hidden md:flex items-center space-x-6 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
        <a href="#inicio" id="nav-home" class="hover:text-foreground transition-colors">Inicio</a>
        <a href="#contacto" id="nav-contact" class="hover:text-foreground transition-colors">Contacto</a>
      </nav>

      <!-- Language Selector -->
      <div class="relative">
        <select 
          id="lang-select" 
          class="bg-neutral-900/80 border border-neutral-700/60 rounded-md text-xs text-foreground px-2.5 py-1 focus:outline-none focus:border-primary cursor-pointer transition-colors"
        >
          <option value="es">ES</option>
          <option value="en">EN</option>
        </select>
      </div>
    </div>

  </div>
</header>

<script>
  import { translations } from '../data/i18n';

  const select = document.getElementById('lang-select') as HTMLSelectElement | null;
  if (select) {
    select.addEventListener('change', (e) => {
      const lang = (e.target as HTMLSelectElement).value as 'es' | 'en';
      
      const navHome = document.getElementById('nav-home');
      const navContact = document.getElementById('nav-contact');

      if (navHome) navHome.textContent = lang === 'es' ? 'Inicio' : 'Home';
      if (navContact) navContact.textContent = lang === 'es' ? 'Contacto' : 'Contact';
    });
  }
</script>