---
import { translations } from '../data/i18n';
const t = translations.es;
---

<section id="contacto" class="py-12 relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Encabezado -->
    <div class="mb-8">
      <h2 id="contact-title" class="inline-block text-2xl md:text-3xl font-bold tracking-tight text-neutral-400 bg-gradient-to-r from-neutral-200 via-neutral-400 to-neutral-500 bg-clip-text text-transparent">
        Contacto
      </h2>
      <div class="w-12 h-1 bg-gradient-primary mt-2 rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Columna Mails Directos -->
      <div class="lg:col-span-4 space-y-4">
        <!-- Email UNJu -->
        <div class="glass-card p-4 rounded-xl border border-border/50 flex items-start space-x-3">
          <div class="p-2.5 bg-primary/10 text-primary rounded-lg shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div>
            <span class="block text-[10px] uppercase tracking-wider text-muted-foreground font-semibold">Email Académico (UNJu)</span>
            <a href="mailto:jose_zapana@fi.unju.edu.ar" class="text-xs font-bold text-foreground hover:text-primary transition-colors block mt-1">
              jose_zapana@fi.unju.edu.ar
            </a>
          </div>
        </div>

        <!-- Email Blimop -->
        <div class="glass-card p-4 rounded-xl border border-border/50 flex items-start space-x-3">
          <div class="p-2.5 bg-primary/10 text-primary rounded-lg shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          </div>
          <div>
            <span class="block text-[10px] uppercase tracking-wider text-muted-foreground font-semibold">Email Corporativo (Blimop)</span>
            <a href="mailto:jose.zapana@blimop.tech" class="text-xs font-bold text-foreground hover:text-primary transition-colors block mt-1">
              jose.zapana@blimop.tech
            </a>
          </div>
        </div>

        <!-- Ubicación -->
        <div class="glass-card p-4 rounded-xl border border-border/50 flex items-start space-x-3">
          <div class="p-2.5 bg-primary/10 text-primary rounded-lg shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <span class="block text-[10px] uppercase tracking-wider text-muted-foreground font-semibold">Ubicación</span>
            <span class="text-xs font-bold text-foreground block mt-1">San Salvador de Jujuy, Argentina</span>
          </div>
        </div>
      </div>

      <!-- Columna Formulario General de Contacto -->
      <div class="lg:col-span-8">
        <div class="glass-card p-6 md:p-8 rounded-2xl border border-border/50 space-y-5">
          <div>
            <h3 id="form-heading" class="text-lg font-bold text-foreground">
              Formulario de Contacto
            </h3>
          </div>

          <form 
            id="contact-form"
            name="contacto" 
            method="POST" 
            data-netlify="true" 
            netlify-honeypot="bot-field"
            class="space-y-4"
          >
            <!-- Campos requeridos por Netlify Forms -->
            <input type="hidden" name="form-name" value="contacto" />
            
            <!-- Campo Honeypot para Trampa de Spam (Invisible para usuarios) -->
            <p class="hidden">
              <label>No llenar esto si sos humano: <input name="bot-field" /></label>
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label id="lbl-name" class="block text-[11px] font-semibold uppercase tracking-wider text-neutral-400 mb-1.5">Nombre / Empresa</label>
                <input 
                  type="text" 
                  name="nombre" 
                  required 
                  placeholder="Tu nombre o empresa" 
                  class="w-full bg-neutral-900/60 border border-neutral-800 rounded-lg px-3.5 py-2 text-xs text-neutral-200 focus:outline-none focus:border-cyan-500 transition-colors" 
                />
              </div>
              <div>
                <label id="lbl-email" class="block text-[11px] font-semibold uppercase tracking-wider text-neutral-400 mb-1.5">Correo Electrónico</label>
                <input 
                  type="email" 
                  name="email" 
                  required 
                  placeholder="contacto@ejemplo.com" 
                  class="w-full bg-neutral-900/60 border border-neutral-800 rounded-lg px-3.5 py-2 text-xs text-neutral-200 focus:outline-none focus:border-cyan-500 transition-colors" 
                />
              </div>
            </div>

            <div>
              <label id="lbl-reason" class="block text-[11px] font-semibold uppercase tracking-wider text-neutral-400 mb-1.5">Motivo de Consulta</label>
              <select 
                name="motivo" 
                class="w-full bg-neutral-900/60 border border-neutral-800 rounded-lg px-3.5 py-2 text-xs text-neutral-200 focus:outline-none focus:border-cyan-500 transition-colors cursor-pointer"
              >
                <option value="Reclutamiento / Pasantías">Reclutamiento / Pasantías de Alumnos</option>
                <option value="Proyecto de Vinculación">Proyecto de Vinculación Tecnológica</option>
                <option value="Servicios / Consultoría IA">Servicios / Consultoría en Ingeniería & IA</option>
                <option value="Consulta General">Consulta General / Propuesta</option>
              </select>
            </div>

            <div>
              <label id="lbl-msg" class="block text-[11px] font-semibold uppercase tracking-wider text-neutral-400 mb-1.5">Mensaje</label>
              <textarea 
                name="mensaje" 
                rows="4" 
                required 
                placeholder="Escribí tu mensaje..." 
                class="w-full bg-neutral-900/60 border border-neutral-800 rounded-lg px-3.5 py-2 text-xs text-neutral-200 focus:outline-none focus:border-cyan-500 transition-colors resize-none"
              ></textarea>
            </div>

            <!-- Contenedor para feedback de estado del envío -->
            <div id="form-status" class="hidden text-xs font-mono p-3 rounded-lg border"></div>

            <!-- Botón de Envío Activo -->
            <button 
              type="submit" 
              id="btn-submit"
              class="px-5 py-2.5 rounded-lg text-xs font-semibold bg-cyan-600 hover:bg-cyan-500 text-white border border-cyan-400/30 transition-all flex items-center space-x-2 cursor-pointer shadow-lg shadow-cyan-950/50"
            >
              <span>Enviar Mensaje</span>
              <span>&rarr;</span>
            </button>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { translations } from '../data/i18n';

  // Lógica de i18n
  const select = document.getElementById('lang-select') as HTMLSelectElement | null;
  if (select) {
    select.addEventListener('change', (e) => {
      const lang = (e.target as HTMLSelectElement).value as 'es' | 'en';
      
      const title = document.getElementById('contact-title');
      const heading = document.getElementById('form-heading');

      if (title) title.textContent = lang === 'es' ? 'Contacto' : 'Contact';
      if (heading) heading.textContent = lang === 'es' ? 'Formulario de Contacto' : 'Contact Form';
    });
  }

  // Manejo del envío asíncrono con Fetch a Netlify Forms
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement | null;
  const statusDiv = document.getElementById('form-status') as HTMLDivElement | null;

  if (form && btnSubmit && statusDiv) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // UI: Estado Cargando
      btnSubmit.disabled = true;
      btnSubmit.classList.add('opacity-50', 'cursor-not-allowed');
      btnSubmit.innerHTML = `<span>Enviando...</span>`;

      statusDiv.classList.add('hidden');
      statusDiv.className = 'text-xs font-mono p-3 rounded-lg border hidden';

      const formData = new FormData(form);

      try {
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(formData as any).toString(),
        });

        if (response.ok) {
          // UI: Éxito
          statusDiv.textContent = '✓ Mensaje enviado con éxito. Te responderé a la brevedad.';
          statusDiv.className = 'text-xs font-mono p-3 rounded-lg border border-emerald-500/40 bg-emerald-950/40 text-emerald-300 block';
          form.reset();
        } else {
          throw new Error('Error en el servidor de formularios.');
        }
      } catch (err) {
        // UI: Error
        statusDiv.textContent = '✕ Ocurrió un error al enviar el mensaje. Intentá nuevamente o escribime por mail.';
        statusDiv.className = 'text-xs font-mono p-3 rounded-lg border border-rose-500/40 bg-rose-950/40 text-rose-300 block';
      } finally {
        // Restaurar Botón
        btnSubmit.disabled = false;
        btnSubmit.classList.remove('opacity-50', 'cursor-not-allowed');
        btnSubmit.innerHTML = `<span>Enviar Mensaje</span> <span>&rarr;</span>`;
      }
    });
  }
</script>