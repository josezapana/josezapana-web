---
import { translations } from '../data/i18n';
const t = translations.es;
---

<section id="contacto" class="py-12 relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Encabezado -->
    <div class="mb-8">
      <h2 id="contact-title" class="inline-block text-2xl md:text-3xl font-bold tracking-tight text-neutral-400 bg-gradient-to-r from-neutral-200 via-neutral-400 to-neutral-500 bg-clip-text text-transparent">
        Contacto
      </h2>
      <div class="w-12 h-1 bg-gradient-primary mt-2 rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Columna Mails Directos -->
      <div class="lg:col-span-4 space-y-4">
        <!-- Email UNJu -->
        <div class="glass-card p-4 rounded-xl border border-border/50 flex items-start space-x-3">
          <div class="p-2.5 bg-primary/10 text-primary rounded-lg shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div>
            <span class="block text-[10px] uppercase tracking-wider text-muted-foreground font-semibold">Email Académico (UNJu)</span>
            <a href="mailto:jose_zapana@fi.unju.edu.ar" class="text-xs font-bold text-foreground hover:text-primary transition-colors block mt-1">
              jose_zapana@fi.unju.edu.ar
            </a>
          </div>
        </div>

        <!-- Email Blimop -->
        <div class="glass-card p-4 rounded-xl border border-border/50 flex items-start space-x-3">
          <div class="p-2.5 bg-primary/10 text-primary rounded-lg shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          </div>
          <div>
            <span class="block text-[10px] uppercase tracking-wider text-muted-foreground font-semibold">Email Corporativo (Blimop)</span>
            <a href="mailto:jose.zapana@blimop.tech" class="text-xs font-bold text-foreground hover:text-primary transition-colors block mt-1">
              jose.zapana@blimop.tech
            </a>
          </div>
        </div>

        <!-- Ubicación -->
        <div class="glass-card p-4 rounded-xl border border-border/50 flex items-start space-x-3">
          <div class="p-2.5 bg-primary/10 text-primary rounded-lg shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <span class="block text-[10px] uppercase tracking-wider text-muted-foreground font-semibold">Ubicación</span>
            <span class="text-xs font-bold text-foreground block mt-1">San Salvador de Jujuy, Argentina</span>
          </div>
        </div>
      </div>

      <!-- Columna Formulario General de Contacto -->
      <div class="lg:col-span-8">
        <div class="glass-card p-6 md:p-8 rounded-2xl border border-border/50 space-y-5">
          <div>
            <h3 id="form-heading" class="text-lg font-bold text-foreground">
              Formulario de Contacto
            </h3>
          </div>

          <form onsubmit="return false;" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label id="lbl-name" class="block text-[11px] font-semibold uppercase tracking-wider text-neutral-400 mb-1.5">Nombre / Empresa</label>
                <input type="text" placeholder="Tu nombre o empresa" disabled class="w-full bg-neutral-900/60 border border-neutral-800 rounded-lg px-3.5 py-2 text-xs text-neutral-500 cursor-not-allowed focus:outline-none" />
              </div>
              <div>
                <label id="lbl-email" class="block text-[11px] font-semibold uppercase tracking-wider text-neutral-400 mb-1.5">Correo Electrónico</label>
                <input type="email" placeholder="contacto@ejemplo.com" disabled class="w-full bg-neutral-900/60 border border-neutral-800 rounded-lg px-3.5 py-2 text-xs text-neutral-500 cursor-not-allowed focus:outline-none" />
              </div>
            </div>

            <div>
              <label id="lbl-reason" class="block text-[11px] font-semibold uppercase tracking-wider text-neutral-400 mb-1.5">Motivo de Consulta</label>
              <select disabled class="w-full bg-neutral-900/60 border border-neutral-800 rounded-lg px-3.5 py-2 text-xs text-neutral-500 cursor-not-allowed focus:outline-none">
                <option>Consulta General / Propuesta</option>
              </select>
            </div>

            <div>
              <label id="lbl-msg" class="block text-[11px] font-semibold uppercase tracking-wider text-neutral-400 mb-1.5">Mensaje</label>
              <textarea rows="4" placeholder="Escribí tu mensaje..." disabled class="w-full bg-neutral-900/60 border border-neutral-800 rounded-lg px-3.5 py-2 text-xs text-neutral-500 cursor-not-allowed focus:outline-none resize-none"></textarea>
            </div>

            <!-- Botón de Envío Inhabilitado -->
            <button 
              type="button" 
              disabled 
              id="btn-submit"
              class="px-5 py-2.5 rounded-lg text-xs font-semibold bg-emerald-800/40 text-emerald-400/60 border border-emerald-700/30 cursor-not-allowed opacity-60 flex items-center space-x-2"
            >
              <span>Enviar Mensaje</span>
              <span>→</span>
            </button>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { translations } from '../data/i18n';

  const select = document.getElementById('lang-select') as HTMLSelectElement | null;
  if (select) {
    select.addEventListener('change', (e) => {
      const lang = (e.target as HTMLSelectElement).value as 'es' | 'en';
      
      const title = document.getElementById('contact-title');
      const heading = document.getElementById('form-heading');

      if (title) title.textContent = lang === 'es' ? 'Contacto' : 'Contact';
      if (heading) heading.textContent = lang === 'es' ? 'Formulario de Contacto' : 'Contact Form';
    });
  }
</script>