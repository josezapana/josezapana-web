---
import { getCollection } from 'astro:content';
import StudentCard from './StudentCard.astro';

const rawProjects = await getCollection('student-projects');

const projects = rawProjects.map((project) => {
  const data = project.data as any;
  return {
    id: project.id,
    title: data.title,
    student: data.student || (data.students && data.students[0]) || "Alumno UNJu",
    summary: data.summary || data.description || "",
    tags: data.tags || []
  };
});
---

<section id="alumnos" class="py-20 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="mb-12">
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
      Proyectos de <span class="text-primary">Alumnos</span>
    </h2>
    <div class="w-12 h-1 bg-gradient-to-r from-blue-500 to-cyan-400 mt-2 rounded-full"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {projects.length > 0 ? (
      projects.map((project) => (
        <StudentCard
          title={project.title}
          student={project.student}
          summary={project.summary}
          tags={project.tags}
          slug={project.id}
        />
      ))
    ) : (
      <div class="col-span-full p-8 border border-neutral-800 rounded-xl bg-neutral-900/40 text-center">
        <p class="text-neutral-400">No hay proyectos publicados aún.</p>
      </div>
    )}
  </div>
</section>